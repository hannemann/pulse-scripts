monitor.alsa.rules = [
  {
    matches = [
      {
        device.name = "alsa_card.pci-0000_03_00.1"
      }
    ]
    actions = {
      update-props = {
        device.description = "HDMI"
      }
    }
  }
  {
    matches = [
      {
        device.name = "alsa_card.pci-0000_00_1f.3"
      }
    ]
    actions = {
      update-props = {
        device.description = "Intern"
      }
    }
  }
  {
    matches = [
      {
        device.name = "alsa_card.usb-Anker_PowerConf_C200_Anker_PowerConf_C200_ACNV9P1E21574591-02"
      }
    ]
    actions = {
      update-props = {
        device.description = "Webcam"
      }
    }
  }
  {
    matches = [
      {
        device.name = "alsa_card.usb-Actions_G06-BT_0123456789AB-01"
      }
    ]
    actions = {
      update-props = {
        device.description = "Headset WL"
      }
    }
  }
]
