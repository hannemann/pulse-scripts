monitor.alsa.rules = [
  {
    matches = [
      {
        node.name = "alsa_output.pci-0000_00_1f.3.iec958-stereo"
      }
    ]
    actions = {
      update-props = {
        node.description = "Intern"
      }
    }
  }
  {
    matches = [
      {
        node.name = "alsa_output.pci-0000_03_00.1.hdmi-stereo-extra3"
      }
    ]
    actions = {
      update-props = {
        node.description = "HDMI"
      }
    }
  }
  {
    matches = [
      {
        node.name = "alsa_output.usb-Actions_G06-BT_0123456789AB-01.analog-stereo"
      }
    ]
    actions = {
      update-props = {
        node.description = "Headset WL"
      }
    }
  }
]
