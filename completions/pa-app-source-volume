#/usr/bin/env bash

. $HOME/.local/share/pulse-scripts/pa-function-lib

_pa-app-source-volume_completions() {

    COMPREPLY=()
    local CUR=${COMP_WORDS[COMP_CWORD]} 
    local MODS="+ - toggle"
    
    if [[ $COMP_CWORD -eq 1 ]]; then
        mapfile -t patterns < <( get_pa_app_list record )
        mapfile -t COMPREPLY < <( compgen -W "$( printf '%q ' "${patterns[@]}" )" -- "${CUR}" | awk '/ / { print "\""$0"\"" } /^[^ ]+$/ { print $0 }' )
    elif [[ $COMP_CWORD -eq 2 ]]; then
        COMPREPLY=( $(compgen -W "${MODS}" -- ${CUR}) )
    fi
}

complete -F _pa-app-source-volume_completions pa-app-source-volume