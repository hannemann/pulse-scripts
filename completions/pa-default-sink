#/usr/bin/env bash

. $HOME/.local/share/pulse-scripts/pa-function-lib

_pa-default-sink_completions() {

    COMPREPLY=()
    local CUR=${COMP_WORDS[COMP_CWORD]}
    
    if [[ $COMP_CWORD -eq 1 ]]; then
        mapfile -t patterns < <( get_pa_sinks_list )
        mapfile -t COMPREPLY < <( compgen -W "$( printf '%q ' "${patterns[@]}" )" -- "${CUR}" | awk '/ / { print "\""$0"\"" } /^[^ ]+$/ { print $0 }' )
    fi
}

complete -F _pa-default-sink_completions pa-default-sink