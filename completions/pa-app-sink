#/usr/bin/env bash

. $HOME/.local/share/pulse-scripts/pa-function-lib

_pa-app-sink_completions() {
    COMPREPLY=();
    local CUR=${COMP_WORDS[COMP_CWORD]}
    local OUTPUTS=$(get_pa_sinks_list)
    local APPS=$(get_pa_app_list)
    
    if [[ $COMP_CWORD -eq 1 ]]; then
        mapfile -t patterns < <( get_pa_app_list )
        mapfile -t COMPREPLY < <( compgen -W "$( printf '%q ' "${patterns[@]}" )" -- "${CUR}" | awk '/ / { print "\""$0"\"" } /^[^ ]+$/ { print $0 }' )
    elif [[ $COMP_CWORD -eq 2 ]]; then
        mapfile -t patterns < <( get_pa_sinks_list )
        mapfile -t COMPREPLY < <( compgen -W "$( printf '%q ' "${patterns[@]}" )" -- "${CUR}" | awk '/ / { print "\""$0"\"" } /^[^ ]+$/ { print $0 }' )
    fi
}

complete -F _pa-app-sink_completions pa-app-sink; 