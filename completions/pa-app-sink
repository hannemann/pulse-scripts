#/usr/bin/env bash

. $HOME/.local/share/pulse-scripts/pa-function-lib

_pa-app-sink_completions() {
    COMPREPLY=();
    local CUR=${COMP_WORDS[COMP_CWORD]}
    local OUTPUTS=$(grep 'alsa_output' $HOME/.config/pulse-scripts/entities | column -t -s '=' | awk '{print $1}')
    local APPS=$(get_pa_app_list)
    
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${APPS}" -- ${CUR}) )
    elif [[ $COMP_CWORD -eq 2 ]]; then
        COMPREPLY=( $(compgen -W "${OUTPUTS}" -- ${CUR}) )
    fi
}

complete -F _pa-app-sink_completions pa-app-sink; 