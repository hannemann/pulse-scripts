#!/bin/bash

SELECTOR_NODE_TYPE='.type == "PipeWire:Interface:Node"'
SELECTOR_DEVICE_TYPE='.type == "PipeWire:Interface:Device"'
SELECTOR_AUDIO_DEVICE_CLASS='.info.props."media.class" == "Audio/Device"'
SELECTOR_SINK_CLASS='.info.props."media.class" == "Audio/Sink"'               # input (speakers)
SELECTOR_SOURCE_CLASS='.info.props."media.class" == "Audio/Source"'           # output (microphone)
SELECTOR_AUDIO_OUT_CLASS='.info.props."media.class" == "Stream/Output/Audio"' # playback
SELECTOR_AUDIO_IN_CLASS='.info.props."media.class" == "Stream/Input/Audio"'   # record

PATH_PROP_NODE_DESCRIPTION='.info.props."node.description"'
PATH_PROP_NODE_NAME='.info.props."node.name"'
PATH_PROP_DEVICE_DESCRIPTION='.info.props."device.description"'
PATH_PROP_DEVICE_NAME='.info.props."device.name"'
PATH_PROP_OBJECT_SERIAL='.info.props."object.serial"'
PATH_PROP_DEVICE_CURRENT_PROFILE_DESCRIPTION='.info.params.Profile[0].description'
PATH_PROP_PROFILE_DESCRIPTION='.description'
PATH_PROP_APP_BINARY='.info.props."application.process.binary"'
PATH_PROP_APP_NAME='.info.props."application.name"'
PATH_PROP_DRIVER_ID='.info.props."node.driver-id"'
PATH_PROP_ID='.id'
PATH_PROP_INDEX='.index'

# obtain indices
################

###
 #
 # Obtain sink index
 # @param $1 sink node description
 # @returns int index of sink
###
get_pa_connector_index() {
	local LANG=LC_ALL
	[[ $1 == 'record' ]] && TYPE="${SELECTOR_SOURCE_CLASS}" || TYPE="${SELECTOR_SINK_CLASS}"
	shift
	pw-dump | \
	jq -r --arg SEARCH "$*" ".[]
		| select(${SELECTOR_NODE_TYPE} and ${TYPE} and ${PATH_PROP_NODE_DESCRIPTION} == \$SEARCH)
		| ${PATH_PROP_ID}"
}

###
 #
 # Obtain max app index
 # some apps are enlisted multiple times. we assume that the max index is the one we are looking for
 # @param $1 app name or binary name
 # @returns int max index of app
###
get_pa_app_index() {
	local LANG=LC_ALL
	[[ $1 == 'record' ]] && TYPE="${SELECTOR_AUDIO_IN_CLASS}" || TYPE="${SELECTOR_AUDIO_OUT_CLASS}"
	shift
	SEARCH=$(cut -d'-' -f1 <<< ${*})
	SERIAL=$(cut -d'-' -f2 <<< ${*})
	pw-dump | \
	jq -r --arg SEARCH "${SEARCH}" --arg SERIAL "${SERIAL}" ".[] |
		select(
			${SELECTOR_NODE_TYPE} and ${TYPE}
			and (${PATH_PROP_APP_BINARY} == \$SEARCH or ${PATH_PROP_APP_NAME} == \$SEARCH)
			and (${PATH_PROP_OBJECT_SERIAL}|tostring) == \$SERIAL
		)
		| ${PATH_PROP_ID}"
}

###
 #
 # Obtain card index
 # @param $1 card description
 # @returns int index of card
###
get_pa_card_index() {
	local LANG=LC_ALL
	pw-dump | \
	jq -r --arg SEARCH "$1" ".[]
		| select(${SELECTOR_DEVICE_TYPE} and ${SELECTOR_AUDIO_DEVICE_CLASS} and ${PATH_PROP_DEVICE_DESCRIPTION} == \$SEARCH)
		| ${PATH_PROP_ID}"
}

###
 #
 # Obtain profile index by card
 # @param $1 card description
 # @param $2 profile description 
 # @returns int index of card profile
###
get_pa_card_profile_index() {
	local LANG=LC_ALL
	pw-dump | \
	jq -r --arg CARD "$1" --arg SEARCH "$2" ".[]
		| select(${SELECTOR_DEVICE_TYPE} and ${SELECTOR_AUDIO_DEVICE_CLASS} and ${PATH_PROP_DEVICE_DESCRIPTION} == \$CARD)
		| .info.params.EnumProfile[]
		| select(.available == "\""yes"\"" and ${PATH_PROP_PROFILE_DESCRIPTION} == \$SEARCH)
		| ${PATH_PROP_INDEX}"
}

# Obtain lists
##############

###
 #
 # Obtain sinks list
 # @returns string[] list of sinks
###
get_pa_connectors_list() {
	local LANG=LC_ALL
	[[ $1 == 'record' ]] && TYPE="${SELECTOR_SOURCE_CLASS}" || TYPE="${SELECTOR_SINK_CLASS}"
	pw-dump | \
	jq -r ".[] | select(${SELECTOR_NODE_TYPE} and ${TYPE}) | ${PATH_PROP_NODE_DESCRIPTION}"
}

###
 #
 # Obtain sink ids list
 # @returns int[] list of sink ids
###
get_pa_connector_ids_list() {
	local LANG=LC_ALL
	[[ $1 == 'record' ]] && TYPE="${SELECTOR_SOURCE_CLASS}" || TYPE="${SELECTOR_SINK_CLASS}"
	pw-dump | \
	jq -r ".[] | select(${SELECTOR_NODE_TYPE} and ${TYPE}) | ${PATH_PROP_ID}"
}

###
 #
 # Obtain sinks info
 # @returns string[] list of sinks info (id, description and name)
###
get_pa_connectors_info() {
	local LANG=LC_ALL
	[[ $1 == 'record' ]] && TYPE="${SELECTOR_SOURCE_CLASS}" || TYPE="${SELECTOR_SINK_CLASS}"
	pw-dump | \
	jq -r ".[] | select(${SELECTOR_NODE_TYPE} and ${TYPE})
		| (${PATH_PROP_ID}|tostring) + "\"":"\"" + ${PATH_PROP_NODE_DESCRIPTION} + "\"":"\"" + ${PATH_PROP_NODE_NAME}"
}

###
 #
 # Obtain cards list
 # @returns string[] list of card descriptions
###
get_pa_cards_list() {
	local LANG=LC_ALL
	pw-dump | \
	jq -r ".[] | select(${SELECTOR_DEVICE_TYPE} and ${SELECTOR_AUDIO_DEVICE_CLASS}) | ${PATH_PROP_DEVICE_DESCRIPTION}"
}

###
 #
 # Obtain cards info
 # @returns string[] list of cards info (id, description and name)
###
get_pa_cards_info() {
	local LANG=LC_ALL
	pw-dump | \
	jq -r ".[] | select(${SELECTOR_DEVICE_TYPE} and ${SELECTOR_AUDIO_DEVICE_CLASS})
		| (${PATH_PROP_ID}|tostring) + "\"":"\""
		+ ${PATH_PROP_DEVICE_DESCRIPTION} + "\"":"\""
		+ ${PATH_PROP_DEVICE_CURRENT_PROFILE_DESCRIPTION} + "\"":"\""
		+ ${PATH_PROP_DEVICE_NAME}"
}

###
 #
 # Obtain available profiles by card
 # @param $1 is a string representing card description to search for profiles on
 # @returns string[] list of card profile descriptions
###
get_pa_card_profiles_list() {
	local LANG=LC_ALL
	#set -x
	#echo jq -r --arg SEARCH "${*//\"/}" ".[] | select(${SELECTOR_DEVICE_TYPE} and ${SELECTOR_AUDIO_DEVICE_CLASS} and ${PATH_PROP_DEVICE_DESCRIPTION} == \$SEARCH) | .info.params.EnumProfile[] | select(.available == "\""yes"\"") | .description"
	#set +x
	pw-dump | jq -r --arg SEARCH "${*//\"/}" ".[]
		| select(${SELECTOR_DEVICE_TYPE} and ${SELECTOR_AUDIO_DEVICE_CLASS} and ${PATH_PROP_DEVICE_DESCRIPTION} == \$SEARCH)
		| .info.params.EnumProfile[] | select(.available != "\""false"\"") | .description"
}

###
 #
 # Obtain apps list
 # @param $1 represents the audio class selector playback|record
 # @returns string[] list of app names or app binary names
###
get_pa_app_list() {
	local LANG=LC_ALL
	[[ $1 == 'record' ]] && TYPE="${SELECTOR_AUDIO_IN_CLASS}" || TYPE="${SELECTOR_AUDIO_OUT_CLASS}"
	#set -x
	#echo jq -r ".[] | select(${SELECTOR_NODE_TYPE} and ${TYPE}) | if ${PATH_PROP_APP_BINARY} == null then ${PATH_PROP_APP_NAME} else ${PATH_PROP_APP_BINARY} end + "\"":"\"" + (${PATH_PROP_ID}|tostring)"
	#set +x
	pw-dump | \
	jq -r ".[]
		| select(${SELECTOR_NODE_TYPE} and ${TYPE})
		| if ${PATH_PROP_APP_BINARY} == null then ${PATH_PROP_APP_NAME} else ${PATH_PROP_APP_BINARY} end + "\""-"\""
		+ (${PATH_PROP_OBJECT_SERIAL}|tostring)"
}

###
 #
 # Obtain apps info
 # @param $1 represents the audio class selector playback|record
 # @returns string[] list of apps info
###
get_pa_app_info() {
	local LANG=LC_ALL
	IFS=$'\n'
	[[ $1 == 'record' ]] && TYPE="${SELECTOR_AUDIO_IN_CLASS}" || TYPE="${SELECTOR_AUDIO_OUT_CLASS}"
	DUMP=$(pw-dump)
	APPS=$(echo ${DUMP} | \
	jq -r ".[]
		| select(${SELECTOR_NODE_TYPE} and ${TYPE})
		| (${PATH_PROP_ID}|tostring) + "\"":"\"" + (${PATH_PROP_OBJECT_SERIAL}|tostring) + "\"":"\""
		+ if ${PATH_PROP_APP_BINARY} == null then ${PATH_PROP_APP_NAME} else ${PATH_PROP_APP_BINARY} end + "\"":"\""
		+ (${PATH_PROP_DRIVER_ID}|tostring)")
	
	for APP_INFO in ${APPS}; do
		APP_ID=$(cut -d':' -f1 <<< ${APP_INFO})
		DRIVER=$(cut -d':' -f4 <<< ${APP_INFO})
		NAME=$(echo ${DUMP} | jq -r --arg DRIVER "$DRIVER" ".[] | select(.id == $DRIVER) | ${PATH_PROP_NODE_DESCRIPTION}")
		VOLUME=$(wpctl get-volume ${APP_ID} | cut -d ' ' -f2)
		[ -z $(which bc 2> /dev/null) ] || VOLUME=$(bc <<< "${VOLUME} * 100")
		echo ${APP_INFO}:${NAME}:${VOLUME}%
	done
}

# Print Info
############

pa_print_entities() {
	PREPEND_LINE="---:-----------:----"

	echo "Sinks (Output):"
	echo ===============
	echo -e "${PREPEND_LINE}\n$(get_pa_connectors_info playback)" | column -t -s':' -N ID,Description,Name
	echo
	echo "Sources (Input):"
	echo ================
	echo -e "${PREPEND_LINE}\n$(get_pa_connectors_info record)" | column -t -s':' -N ID,Description,Name
	echo
	PREPEND_LINE="---:-----------:-------:----"
	echo "Cards:"
	echo ======
	echo -e "${PREPEND_LINE}\n$(get_pa_cards_info)" | column -t -s':' -N ID,Description,Profile,Name -W Profile -T Profile
}

pa_print_app_info() {
	PREPEND_LINE="--:------:---:---------:------------:------"
	PLAYBACK=$(get_pa_app_info playback)
	RECORD=$(get_pa_app_info record)

	if ! [[ -z ${PLAYBACK} ]]; then
		echo "Playback:"
		echo "========="
		echo -e "${PREPEND_LINE}\n${PLAYBACK}" | column -t -s':' -N ID,Serial,App,"Sink ID","Sink Desc.","Volume"
	fi
	if ! [[ -z ${PLAYBACK} ]] && ! [[ -z ${RECORD} ]]; then
		echo
	fi
	if ! [[ -z ${RECORD} ]]; then
		echo "Record:"
		echo "======="
		echo -e "${PREPEND_LINE}\n${RECORD}" | column -t -s':' -N ID,Serial,App,"Source ID","Source Desc.","Volume"
	fi
}