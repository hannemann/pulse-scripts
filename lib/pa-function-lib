#!/bin/bash

# obtain indices
################

###
 #
 # Obtain sink index
 #
###
get_pa_sink_index() {
	LANG=LC_ALL pactl -f json list sinks 2> /dev/null | \
	jq -r --arg SINK "$1" '.[] | select(.description == $SINK) | .index'
}

###
 #
 # Obtain source index
 #
###
get_pa_source_index() {
	if [[ $1 = *.monitor ]]; then
		MONITOR_CONDITION=".monitor_source != \"\""
	else
		MONITOR_CONDITION=".monitor_source == \"\""
	fi
	LANG=LC_ALL pactl -f json list sources 2> /dev/null | \
	jq -r ".[] | select(${MONITOR_CONDITION} and .description == \"${1%.monitor}\") | .index"
}

###
 #
 # Obtain app index
 #
###
get_pa_app_index() {
	if [[ $1 == "slack" ]]; then
		CONDITION_PROPERTY="target.object"
	else
		CONDITION_PROPERTY="node.driver-id"
	fi
	LANG=LC_ALL pactl -f json list sink-inputs 2> /dev/null | \
	jq -r --arg APP "$1" ".[] | select(.properties.\"${CONDITION_PROPERTY}\" != null and (.properties.\"application.process.binary\" == \"$1\" or .properties.\"application.name\" == \"$1\")) | .index" | \
	sort -un | tail -n1
}

###
 #
 # Obtain app source index
 #
###
get_pa_app_source_index() {
	LANG=LC_ALL pactl -f json list source-outputs 2> /dev/null | \
	jq -r --arg APP "$1" '.[] | select(.properties."application.name" == $APP or .properties."application.process.binary" == $APP) | .index'
}

###
 #
 # Obtain card index
 #
###
get_pa_card_index() {
	LANG=LC_ALL pactl -f json list cards 2> /dev/null | \
	jq -r --arg CARD "$1" '.[] | select(.description == $CARD) | .index'
}

# Obtain lists
##############

###
 #
 # Obtain sinks list
 #
###
get_pa_sinks_list() {
	LAND=LC_ALL pactl -f json list sinks 2> /dev/null | \
	jq -r '.[] | .description'
}

###
 #
 # Obtain sources list
 #
###
get_pa_sources_list() {
	LAND=LC_ALL pactl -f json list sources 2> /dev/null | \
	jq -r '.[] | .description + (if .monitor_source != "" then ".monitor" else "" end)'
}

###
 #
 # Obtain sources list
 #
###
get_pa_cards_list() {
	LAND=LC_ALL pactl -f json list cards 2> /dev/null | \
	jq -r '.[] | .description'
}

###
 #
 # Obtain apps list
 #
###
get_pa_app_list() {
	LANG=LC_ALL pactl -f json list sink-inputs 2> /dev/null | \
	jq -r  '.[] | select(.properties."node.driver-id" != null) | if .properties."application.process.binary" == null then .properties."application.name" else .properties."application.process.binary" end'
}

###
 #
 # Obtain app sources list
 #
###
get_pa_app_source_list() {
	LANG=LC_ALL pactl -f json list source-outputs 2> /dev/null | \
	jq -r '.[] | select(.properties."application.name" != "(null)") | if .properties."application.process.binary" == null then .properties."application.name" else .properties."application.process.binary" end'
}

